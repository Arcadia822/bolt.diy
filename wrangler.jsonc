{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bolt",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  /*
   * Magpie (host-a1) exposes an OpenAI-compatible `/v1`. The OpenAILike
   * provider only reads `context.cloudflare.env`, i.e. Worker bindings —
   * neither `.env` nor the parent process environment reaches workerd, so the
   * defaults have to live here.
   */
  /*
   * Only models verified against host-a1 are pinned: `group/*` routing groups
   * and most `cloudwise/*` ids currently answer 400/403/429 (credits or
   * allow-list). Adding a model here is a promise that it completes, so grow
   * this list from the provider's own /v1/models only after a real call works.
   * Format: "model:maxTokens;model:maxTokens".
   */
  "vars": {
    "OPENAI_LIKE_API_BASE_URL": "http://100.85.55.0:3425/v1",
    "OPENAI_LIKE_API_KEY": "magpie-local",
    "OPENAI_LIKE_API_MODELS": "cloudwise/glm-5.3-flash:1000000;codex/gpt-6-luna:900000;codex/gpt-6.1-sol:900000;copilot/claude-sonnet-5.5:1000000"
  },
  "upload_source_maps": true
}